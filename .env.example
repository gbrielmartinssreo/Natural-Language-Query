# Selecione o provider usado pelo agente.
#   groq        -> Groq (openai/gpt-oss-120b)
#   openrouter  -> OpenRouter (deepseek/deepseek-v4-flash-0731)
#   ausente     -> usa Groq se a chave do OpenRouter for inválida;
#                  caso contrário, usa OpenRouter.
API_SELECT=groq

# Obrigatória: usada para construir o modelo Groq.
GROQ_API_KEY=sua-chave-groq

# Validada no startup; se falhar, o agente usa o Groq.
OPENROUTER_API_KEY=sua-chave-openrouter

# Usada pela busca semântica (embeddings da OpenAI).
OPENAI_API_KEY=sua-chave-openai

# Teto de tokens gerados pelo modelo por resposta (padrão 5000).
# Respostas que atingem o limite vêm com finish_reason=length e são
# sinalizadas como interrompidas, nunca apresentadas como completas.

#NLQ_MAX_TOKENS=5000

# Poda de contexto: quando o histórico aproximado do thread excede este
# número de tokens, os resultados de ferramenta mais antigos são
# substituídos por "[cleared]" apenas na mensagem enviada ao modelo
# (o checkpointer mantém o histórico completo).

#NLQ_CONTEXT_TRIGGER_TOKENS=25000

# Quantos resultados de ferramenta mais recentes nunca são podados.

#NLQ_CONTEXT_KEEP_TOOL_RESULTS=5

# Máximo de linhas/grupos que consultar_dados devolve por consulta
# (padrão 500). Suba para ler abas inteiras numa única chamada.

#NLQ_MAX_ROWS=500

# Nº de linhas/grupos retornados quando o agente omite 'limite' (padrão 20).

#NLQ_ROWS_DEFAULT=20

# Teto de chamadas de ferramenta por execução do agente (padrão 25).
# Ao atingir o limite, o modelo finaliza com o que já tem.

#NLQ_TOOL_CALL_LIMIT=25

# Raciocínio do modelo (apenas OpenRouter).
#   separate (padrão) -> raciocínio em canal próprio (reasoning_content),
#                        FORA do content; a resposta final fica limpa.
#   exclude           -> o modelo raciocina, mas não devolve o raciocínio.
#   off               -> desliga o raciocínio (mais rápido, porém em tarefas
#                        complexas o modelo pode narrar passos no content).

#NLQ_REASONING=separate
