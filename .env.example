# Selecione o provider usado pelo agente.
#   groq        -> Groq (openai/gpt-oss-120b)
#   openrouter  -> OpenRouter (qwen/qwen3-30b-a3b-instruct-2507)
#   ausente     -> usa Groq se a chave do OpenRouter for inválida;
#                  caso contrário, usa OpenRouter.
API_SELECT=groq

# Obrigatória: usada para construir o modelo Groq.
GROQ_API_KEY=sua-chave-groq

# Validada no startup; se falhar, o agente usa o Groq.
OPENROUTER_API_KEY=sua-chave-openrouter

# Usada pela busca semântica (embeddings da OpenAI).
OPENAI_API_KEY=sua-chave-openai
